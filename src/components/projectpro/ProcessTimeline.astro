
---
import type { ProjectProConfig } from '../../types/projectpro';

interface Props {
  process: ProjectProConfig['process'];
  demo: boolean;
}

const { process, demo } = Astro.props;
---

<section
  id="proces"
  class="scroll-mt-24 overflow-hidden bg-[var(--pp-ink)] py-20 text-white md:py-28"
>
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">

    <!-- SECTION HEADING -->
    <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">

      <div>
        <p class="mb-6 text-[11px] font-extrabold tracking-[0.2em] text-[#DCA18A]">
          {process.eyebrow}
        </p>

        <h2
          class="max-w-[760px] font-display text-[clamp(3rem,5.5vw,5.8rem)] leading-[1.05] tracking-[-0.06em]"
        >
          {process.title}
        </h2>
      </div>

      <p class="max-w-[460px] text-base leading-8 text-white/60 lg:ml-auto">
        {process.description}
      </p>
    </div>

    <!-- TIMELINE -->
    <ol class="mt-16 grid grid-cols-1 lg:mt-22 lg:grid-cols-4">

      {process.steps.map((step) => (
        <li
          class="relative border-l border-white/25 pb-11 pl-8 last:pb-0 lg:border-l-0 lg:border-t lg:pb-0 lg:pl-0 lg:pr-8 lg:pt-11"
        >

          <!-- TIMELINE DOT -->
          <span
            class="absolute -left-[6px] top-0 h-[11px] w-[11px] rounded-full border-[3px] border-[#DCA18A] bg-[var(--pp-ink)] lg:-top-[6px] lg:left-0"
            aria-hidden="true"
          ></span>

          <!-- STEP NUMBER -->
          <span
            class="font-display text-[clamp(3rem,4vw,4.5rem)] leading-none tracking-[-0.05em] text-[#DCA18A]"
          >
            {step.number}
          </span>

          <!-- STEP TITLE -->
          <h3
            class="mt-7 max-w-[300px] font-display text-[clamp(1.6rem,2vw,2rem)] leading-[1.15] tracking-[-0.035em]"
          >
            {step.title}
          </h3>

          <!-- DESCRIPTION -->
          <p
            class="mt-5 max-w-[310px] text-sm leading-[1.9] text-white/60"
          >
            {step.description}
          </p>

          <!-- STEP DETAIL -->
          <div class="mt-8 flex items-start gap-3">
            <span
              class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#DCA18A]"
              aria-hidden="true"
            ></span>

            <p class="text-[11px] font-bold uppercase leading-6 tracking-[0.08em] text-white/80">
              {step.detail}
            </p>
          </div>

        </li>
      ))}

    </ol>

    <!-- BOTTOM CTA -->
    <div
      class="mt-16 flex flex-col justify-between gap-8 border-t border-white/20 pt-9 md:flex-row md:items-center"
    >
      <div class="max-w-[570px]">

        <h3 class="font-display text-2xl tracking-tight md:text-3xl">
          Spremni da započnete?
        </h3>

        <p class="mt-3 text-sm leading-7 text-white/60">
          {process.note}
        </p>

        {demo && (
          <p class="mt-4 text-xs text-[#DCA18A]">
            DEMO CONCEPT — primer organizacije projekta
          </p>
        )}
      </div>

      <a
        href="#upit"
        class="inline-flex min-h-14 shrink-0 items-center justify-center gap-5 self-start bg-[var(--pp-accent)] px-7 py-4 text-sm font-bold text-white transition-colors duration-200 hover:bg-white hover:text-[var(--pp-ink)]"
      >
        Zatražite procenu
        <span aria-hidden="true">↗</span>
      </a>
    </div>

  </div>
</section>
