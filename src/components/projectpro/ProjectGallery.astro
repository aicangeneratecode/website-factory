
---
import type { ProjectProConfig } from '../../types/projectpro';

interface Props {
  portfolio: ProjectProConfig['portfolio'];
  demo: boolean;
}

const { portfolio, demo } = Astro.props;
---

<section
  id="projekti"
  class="scroll-mt-40 bg-[var(--pp-surface)] py-8 md:py-7"
>
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">

    <!-- Section heading -->
    <div class="flex flex-col justify-between gap-3 lg:flex-row lg:items-end lg:gap-12">
      <div class="max-w-[740px]">
        <p class="mb-3 text-[11px] font-extrabold tracking-[0.2em] text-[var(--pp-accent)]">
          {portfolio.eyebrow}
        </p>

        <h2 class="pp-heading text-[clamp(2.125rem,4vw,4.25rem)] leading-[1.05] tracking-[-0.06em]">
          {portfolio.title}
        </h2>
      </div>

      <p class="max-w-[380px] text-sm/6 text-[var(--pp-muted)]">
        {portfolio.description}
      </p>
    </div>

    <!-- Project grid -->
    <div class="mt-6 grid gap-3 md:mt-7 md:grid-cols-12 md:gap-4">
      {portfolio.projects.map((project, index) => (
        <figure
          class:list={[
            'group relative grid min-w-0 content-end overflow-hidden rounded-[10px] bg-[#ddd5ca]',
            index === 0
              ? 'md:col-span-7'
              : index === 1
                ? 'md:col-span-5'
                : 'md:col-span-12',
            index === 2
              ? 'min-h-[calc(clamp(12rem,51vw,16rem)*1.1)] md:min-h-[calc(clamp(12rem,23svh,18rem)*1.1)]'
              : 'min-h-[calc(clamp(12rem,56vw,18rem)*1.1)] md:min-h-[calc(clamp(14rem,30svh,23rem)*1.1)]'
          ]}
        >
          <img
            src={project.image}
            alt={project.imageAlt}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-700 motion-safe:ease-out motion-safe:group-hover:scale-105"
          />

          <!-- Image gradient -->
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>

          {demo && (
            <span class="absolute right-3 top-3 rounded-[10px] bg-white/95 px-3 py-1.5 text-[10px] font-bold tracking-[0.12em] text-[var(--pp-ink)] md:right-4 md:top-4">
              DEMO / ILUSTRACIJA
            </span>
          )}

          <!-- Project caption -->
          <figcaption class="relative px-4 pb-4 pt-14 text-white md:px-6 md:pb-6">
            <p class="mb-2 text-[10px] font-extrabold tracking-[0.2em] text-white/75">
              {project.category}
            </p>

            <h3 class="pp-heading text-[clamp(1.5rem,2.5vw,2.25rem)] leading-tight tracking-tight">
              {project.title}
            </h3>

            <div aria-hidden="true" class="mt-3 h-px w-14 bg-white/80 motion-safe:transition-[width] motion-safe:duration-500 motion-safe:group-hover:w-24"></div>
            <p class="mt-2 text-xs text-white/70">
              {project.note}
            </p>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="mt-4 flex flex-col justify-between gap-2 border-t border-black/10 pt-3 sm:flex-row sm:items-center sm:gap-5">
      <p class="max-w-xl text-xs leading-6 text-[var(--pp-muted)]">
        {demo
          ? 'Fotografije služe kao inspiracija i ne predstavljaju izvedene radove demo kompanije.'
          : 'Svaki prostor zaslužuje pažljivo planiranje i kvalitetnu realizaciju.'}
      </p>

      <a
        href="#upit"
        class="pp-action inline-flex items-center gap-4 text-sm font-bold text-[var(--pp-accent)] transition hover:opacity-60"
      >
        Razgovarajmo o vašem prostoru
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
