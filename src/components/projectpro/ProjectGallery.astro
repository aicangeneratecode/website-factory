
---
import type { ProjectProConfig } from '../../types/projectpro';

interface Props {
  portfolio: ProjectProConfig['portfolio'];
  demo: boolean;
}

const { portfolio, demo } = Astro.props;
---

<section
  id="projekti"
  class="scroll-mt-24 bg-[var(--pp-surface)] py-20 md:py-28"
>
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">

    <!-- Section heading -->
    <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
      <div class="max-w-[740px]">
        <p class="mb-6 text-[11px] font-extrabold tracking-[0.2em] text-[var(--pp-accent)]">
          {portfolio.eyebrow}
        </p>

        <h2 class="font-display text-[clamp(3rem,5.5vw,5.8rem)] leading-[1.05] tracking-[-0.06em]">
          {portfolio.title}
        </h2>
      </div>

      <p class="max-w-[380px] text-sm leading-8 text-[var(--pp-muted)]">
        {portfolio.description}
      </p>
    </div>

    <!-- Project grid -->
    <div class="mt-14 grid gap-5 md:grid-cols-12">
      {portfolio.projects.map((project, index) => (
        <figure
          class:list={[
            'group min-w-0',
            index === 0
              ? 'md:col-span-7'
              : index === 1
                ? 'md:col-span-5'
                : 'md:col-span-12'
          ]}
        >
          <div
            class:list={[
              'relative overflow-hidden bg-[#ddd5ca]',
              index === 2
                ? 'h-[360px] md:h-[440px]'
                : 'h-[390px] md:h-[530px]'
            ]}
          >
            <img
              src={project.image}
              alt={project.imageAlt}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />

            <!-- Image gradient -->
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>

            {demo && (
              <span class="absolute right-5 top-5 bg-white/95 px-4 py-2 text-[10px] font-bold tracking-[0.12em] text-[var(--pp-ink)]">
                DEMO / ILUSTRACIJA
              </span>
            )}

            <!-- Project caption -->
            <figcaption class="absolute bottom-0 left-0 right-0 p-7 text-white md:p-10">
              <p class="mb-3 text-[10px] font-extrabold tracking-[0.2em] text-white/75">
                {project.category}
              </p>

              <h3 class="font-display text-[clamp(1.9rem,3vw,3rem)] leading-tight tracking-tight">
                {project.title}
              </h3>

              <p class="mt-3 text-xs text-white/70">
                {project.note}
              </p>
            </figcaption>
          </div>
        </figure>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="mt-9 flex flex-col justify-between gap-5 border-t border-black/10 pt-7 sm:flex-row sm:items-center">
      <p class="max-w-xl text-xs leading-6 text-[var(--pp-muted)]">
        {demo
          ? 'Fotografije služe kao inspiracija i ne predstavljaju izvedene radove demo kompanije.'
          : 'Svaki prostor zaslužuje pažljivo planiranje i kvalitetnu realizaciju.'}
      </p>

      <a
        href="#upit"
        class="inline-flex items-center gap-4 text-sm font-bold text-[var(--pp-accent)] transition hover:opacity-60"
      >
        Razgovarajmo o vašem prostoru
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
