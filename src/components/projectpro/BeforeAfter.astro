
---
import type { ProjectProConfig } from '../../types/projectpro';

interface Props {
  comparison: NonNullable<ProjectProConfig['beforeAfter']>;
  demo: boolean;
}

const { comparison, demo } = Astro.props;

const beforeLabel = comparison.verifiedPair
  ? 'PRE'
  : 'PRIMER A';

const afterLabel = comparison.verifiedPair
  ? 'POSLE'
  : 'PRIMER B';
---

<section
  id="preposle"
  aria-labelledby="pp-compare-heading"
  class="scroll-mt-48 bg-[var(--pp-bg)] py-8 min-[360px]:scroll-mt-40"
>
  <div class="mx-auto max-w-[1000px] px-6 lg:px-10">
    <div class="mb-6 grid gap-3 lg:grid-cols-[1.5fr_1fr] lg:items-end lg:gap-8">
      <div>
        <p class="mb-3 text-[11px] font-extrabold tracking-[0.2em] text-[var(--pp-accent)]">
          {comparison.eyebrow}
        </p>

        <h2 id="pp-compare-heading" class="pp-heading text-[clamp(2.125rem,3vw,3.25rem)] leading-[1.05] tracking-[-0.06em]">
          {comparison.title}
        </h2>
      </div>

      <p class="max-w-md text-sm/6 text-[var(--pp-muted)] lg:ml-auto">
        {comparison.description}
      </p>
    </div>

    <div data-compare>
      <div
        data-compare-stage
        style="--reveal: 50%"
        class="relative aspect-[3/2] cursor-ew-resize select-none overflow-hidden rounded-[10px] bg-[#d8d4cb] touch-pan-y md:aspect-[7/4]"
      >
        <div class="pointer-events-none absolute inset-0">
          <img
            src={comparison.beforeImage}
            alt={comparison.beforeAlt}
            loading="lazy"
            decoding="async"
            draggable="false"
            class="h-full w-full object-cover"
          />
          <span class="absolute bottom-3 left-3 rounded-[10px] bg-white px-3 py-1.5 text-[11px] font-extrabold tracking-widest text-[var(--pp-ink)] md:bottom-5 md:left-5">
            {beforeLabel}
          </span>
        </div>

        <div class="pointer-events-none absolute inset-0" style="clip-path: inset(0 0 0 var(--reveal))">
          <img
            src={comparison.afterImage}
            alt={comparison.afterAlt}
            loading="lazy"
            decoding="async"
            draggable="false"
            class="h-full w-full object-cover"
          />
          <span class="absolute bottom-3 right-3 rounded-[10px] bg-white px-3 py-1.5 text-[11px] font-extrabold tracking-widest text-[var(--pp-ink)] md:bottom-5 md:right-5">
            {afterLabel}
          </span>
        </div>

        <!-- Divider -->
        <div
          class="pointer-events-none absolute bottom-0 top-0 z-10 w-[2px] -translate-x-1/2 bg-white"
          style="left: var(--reveal)"
          aria-hidden="true"
        ></div>
        <div
          class="pointer-events-none absolute top-1/2 z-10 grid size-12 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-white bg-[var(--pp-accent)] text-lg font-bold text-white shadow-lg"
          style="left: clamp(1.5rem, var(--reveal), calc(100% - 1.5rem))"
          aria-hidden="true"
        >↔</div>

        {!comparison.verifiedPair && (
          <span class="pointer-events-none absolute left-4 top-4 rounded-[10px] bg-[var(--pp-ink)] px-4 py-2 text-[10px] font-bold tracking-wider text-white">
            DEMO POREĐENJE
          </span>
        )}
      </div>

      <!-- Accessible keyboard / touch control -->
      <div class="mt-3 flex items-center gap-3 sm:gap-6">
        <label
          for="pp-compare-range"
          class="shrink-0 text-sm font-bold"
        >
          Pomerite klizač
        </label>

        <input
          id="pp-compare-range"
          disabled
          data-compare-range
          type="range"
          min="0"
          max="100"
          value="50"
          step="1"
          aria-label="Uporedite dve fotografije"
          class="h-11 w-full min-w-0 cursor-ew-resize accent-[var(--pp-accent)]"
        />
      </div>
    </div>

    <div class="mt-3 flex flex-col justify-between gap-2 border-t border-black/10 pt-3 md:flex-row md:items-center">
      <p class="max-w-xl text-xs leading-6 text-[var(--pp-muted)]">
        {demo
          ? 'Ilustrativni prikaz uređenja prostora za demo sajt.'
          : 'Pomerite razdelnik da uporedite prostor pre i posle radova.'}
      </p>

      <a
        href="#upit"
        class="pp-action inline-flex items-center gap-3 self-start text-sm font-bold text-[var(--pp-accent)] transition-colors duration-200 hover:text-[var(--pp-ink)]"
      >
        Zatražite procenu
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>(
      '[data-compare-stage]'
    );

    const slider = root.querySelector<HTMLInputElement>(
      '[data-compare-range]'
    );

    if (!stage || !slider) return;
    slider.disabled = false;

    const setValue = (number: number) => {
      const value = Math.max(0, Math.min(100, number));

      stage.style.setProperty('--reveal', `${value}%`);
      slider.value = String(value);
    };

    const updateFromPointer = (event: PointerEvent) => {
      const rect = stage.getBoundingClientRect();

      if (!rect.width) return;

      const percentage =
        ((event.clientX - rect.left) / rect.width) * 100;

      setValue(Math.round(percentage));
    };

    slider.addEventListener('input', () => {
      setValue(Number(slider.value));
    });

    stage.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) {
        return;
      }

      stage.setPointerCapture(event.pointerId);
      updateFromPointer(event);
    });

    stage.addEventListener('pointermove', (event) => {
      if (stage.hasPointerCapture(event.pointerId)) {
        updateFromPointer(event);
      }
    });

    const releasePointer = (event: PointerEvent) => {
      if (stage.hasPointerCapture(event.pointerId)) {
        stage.releasePointerCapture(event.pointerId);
      }
    };

    stage.addEventListener('pointerup', releasePointer);
    stage.addEventListener('pointercancel', releasePointer);
  });
</script>
