
---
import type { ProjectProConfig } from '../../types/projectpro';

interface Props {
  actionLabel: string;
  services: ProjectProConfig['services'];
}

const { services, actionLabel } = Astro.props;
---

<section
  id="usluge"
  class="scroll-mt-24 bg-[var(--pp-bg)] py-20 md:py-28"
>
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">

    <!-- SECTION HEADING -->
    <div class="grid gap-7 lg:grid-cols-[1.2fr_0.8fr] lg:items-end lg:gap-16">
      <div>
        <p class="mb-6 text-[11px] font-extrabold tracking-[0.2em] text-[var(--pp-accent)]">
          {services.eyebrow}
        </p>

        <h2 class="pp-heading max-w-[780px] text-[clamp(3rem,5.5vw,5.8rem)] leading-[1.05] tracking-[-0.06em]">
          {services.title}
        </h2>
      </div>

      <p class="max-w-[440px] text-base leading-8 text-[var(--pp-muted)] lg:ml-auto">
        {services.description}
      </p>
    </div>

    <!-- SERVICES GRID -->
    <div class="mt-14 grid gap-4 md:grid-cols-2">
      {services.items.map((service) => {
        const dark = service.featured || Boolean(service.image);
        return (
          <article
            class:list={[
              "group relative flex min-h-[410px] flex-col justify-between isolate overflow-hidden rounded-2xl p-7 transition-all duration-300 md:p-10 lg:min-h-[460px] lg:p-12",
              dark
                ? "bg-[var(--pp-ink)] text-white"
                : "border border-black/10 bg-[var(--pp-surface)] text-[var(--pp-ink)] motion-safe:hover:-translate-y-1 hover:shadow-xl"
            ]}
          >
            {service.image && (
              <>
                <img src={service.image.src} alt={service.image.alt} loading="lazy" decoding="async"
                  class="absolute inset-0 -z-20 h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-105" />
                <div class="absolute inset-0 -z-10 bg-black/75" aria-hidden="true"></div>
              </>
            )}
            <!-- TOP -->
            <div>
              <div
                class:list={[
                  "flex items-center justify-between border-b pb-7",
                  dark
                    ? "border-white/20"
                    : "border-black/10"
                ]}
              >
                <span
                  class:list={[
                    "font-display text-4xl",
                    dark
                      ? "text-[#DCA18A]"
                      : "text-[var(--pp-accent)]"
                  ]}
                >
                  {service.number}
                </span>

                <span
                  class:list={[
                    "grid h-12 w-12 place-items-center rounded-full border text-xl transition-transform duration-300 motion-safe:group-hover:rotate-45",
                    dark
                      ? "border-white/30 text-white"
                      : "border-black/15 text-[var(--pp-ink)]"
                  ]}
                  aria-hidden="true"
                >
                  ↗
                </span>
              </div>

              <h3 class="pp-heading mt-9 max-w-[470px] text-[clamp(1.85rem,3vw,3rem)] leading-[1.1] tracking-[-0.04em]">
                {service.title}
              </h3>

              <p
                class:list={[
                  "mt-5 max-w-[470px] text-sm leading-7",
                  dark
                    ? "text-white/65"
                    : "text-[var(--pp-muted)]"
                ]}
              >
                {service.description}
              </p>
            </div>

            <!-- DETAILS + LINK -->
            <div class="mt-10">
              <ul class="space-y-3">
                {service.details.map((detail) => (
                  <li class="flex items-start gap-3 text-[13px] leading-6">
                    <span
                      class:list={[
                        "mt-2 h-1.5 w-1.5 shrink-0 rounded-full",
                        dark
                          ? "bg-[#DCA18A]"
                          : "bg-[var(--pp-accent)]"
                      ]}
                    ></span>
                    <span>{detail}</span>
                  </li>
                ))}
            </ul>

            <a
              href="#upit"
              class:list={[
                "pp-action",
                "mt-9 inline-flex items-center gap-4 border-b pb-2 text-sm font-bold transition-all duration-200 motion-safe:hover:gap-6",
                dark
                  ? "border-white/60 text-white"
                  : "border-[var(--pp-accent)] text-[var(--pp-accent)]"
              ]}
            >
              {actionLabel}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
        );
      })}
    </div>

    <!-- BOTTOM CTA -->
    <div class="mt-14 flex flex-col justify-between gap-7 border-t border-black/15 pt-9 md:flex-row md:items-center">
      <div>
        <h3 class="pp-heading text-2xl tracking-tight md:text-3xl">
          Niste sigurni odakle da počnete?
        </h3>
        <p class="mt-3 text-sm leading-7 text-[var(--pp-muted)]">
          Opišite svoj prostor i radove koje planirate.
        </p>
      </div>

      <a
        href="#upit"
        class="pp-action inline-flex min-h-14 shrink-0 items-center justify-center gap-5 self-start bg-[var(--pp-accent)] px-7 py-4 text-sm font-bold text-white transition-all duration-200 motion-safe:hover:-translate-y-1 hover:bg-[var(--pp-ink)]"
      >
        Pošaljite upit
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
