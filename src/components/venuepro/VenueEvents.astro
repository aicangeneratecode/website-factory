
---
import type { VenueProConfig } from '../../types/venuepro';

interface Props {
  events: VenueProConfig['events'];
  demo: boolean;
}

const { events, demo } = Astro.props;
---

<section
  id="dogadjaji"
  class="scroll-mt-20 bg-[#F7F4EF] py-20 md:py-28"
>
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">

    <!-- SECTION INTRO -->
    <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div>
        <p
          class="mb-7 text-[11px] font-bold tracking-[0.22em] text-[var(--vp-accent)]"
        >
          {events.eyebrow}
        </p>

        <h2
          class="max-w-[790px] font-display text-[clamp(3rem,5.5vw,5.9rem)] leading-[1.06] tracking-[-0.06em]"
        >
          {events.title}
        </h2>
      </div>

      <p
        class="max-w-[450px] text-base leading-8 text-[var(--vp-muted)] lg:ml-auto"
      >
        {events.description}
      </p>
    </div>

    <!-- EDITORIAL EVENT GRID -->
    <div class="mt-14 grid gap-5 lg:grid-cols-2">

      {events.items.map((item, index) => (
        <article
          class:list={[
            'min-w-0 overflow-hidden border border-[#E9E0D5]',
            index === 0
              ? 'bg-[#EBE3D8] lg:col-span-2 lg:grid lg:grid-cols-[1fr_1.05fr]'
              : 'bg-white'
          ]}
        >
          <!-- PHOTO -->
          <div
            class:list={[
              'relative overflow-hidden bg-[#DDD4C8]',
              index === 0
                ? 'h-[370px] lg:order-2 lg:h-[580px]'
                : 'h-[320px] sm:h-[400px]'
            ]}
          >
            <img
              src={item.image}
              alt={item.imageAlt}
              width="1600"
              height="1100"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
            />

            {demo && (
              <span
                class="absolute right-5 top-5 bg-[#F7F4EF]/95 px-4 py-2 text-[10px] font-bold tracking-[0.14em] text-[#292824]"
              >
                ILUSTRACIJA
              </span>
            )}
          </div>

          <!-- CONTENT -->
          <div
            class:list={[
              'flex min-w-0 flex-col justify-between',
              index === 0
                ? 'p-8 sm:p-12 lg:order-1 lg:p-16'
                : 'p-8 sm:p-10'
            ]}
          >
            <div>
              <div
                class="flex items-start justify-between gap-5 border-b border-[#CFC4B5] pb-6"
              >
                <p
                  class="text-[10px] font-bold tracking-[0.18em] text-[var(--vp-accent)]"
                >
                  {item.category}
                </p>

                <span
                  class="font-display text-3xl italic leading-none text-[var(--vp-accent)]"
                >
                  {item.number}
                </span>
              </div>

              <h3
                class:list={[
                  'font-display leading-[1.12] tracking-[-0.045em]',
                  index === 0
                    ? 'mt-10 text-[clamp(2.6rem,4vw,4.6rem)]'
                    : 'mt-8 text-[clamp(2.2rem,3vw,3.5rem)]'
                ]}
              >
                {item.title}
              </h3>

              <p
                class="mt-6 max-w-[530px] text-sm leading-8 text-[var(--vp-muted)] md:text-base"
              >
                {item.description}
              </p>

              <!-- TOPICS -->
              <div class="mt-9">
                <p
                  class="mb-4 text-[10px] font-bold tracking-[0.15em] text-[var(--vp-accent)]"
                >
                  TEME ZA DOGOVOR
                </p>

                <ul class="flex flex-wrap gap-x-5 gap-y-3">
                  {item.topics.map((topic) => (
                    <li
                      class="flex items-center gap-2 text-xs font-medium leading-6 text-[var(--vp-ink)]"
                    >
                      <span
                        aria-hidden="true"
                        class="h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--vp-accent)]"
                      ></span>
                      {topic}
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- CTA -->
            <div
              class="mt-12 border-t border-[#CFC4B5] pt-7"
            >
              <a
                href="#upit"
                class="inline-flex items-center gap-5 border-b border-[var(--vp-ink)] pb-2 text-sm font-semibold text-[var(--vp-ink)] transition-all duration-200 hover:gap-7 hover:text-[var(--vp-accent)]"
              >
                {item.cta}
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- NOTE -->
    {demo && (
      <div class="mt-10 border-t border-[#D8CDBF] pt-6">
        <p
          class="max-w-[800px] text-xs leading-7 text-[var(--vp-muted)]"
        >
          {events.note}
        </p>
      </div>
    )}
  </div>
</section>
