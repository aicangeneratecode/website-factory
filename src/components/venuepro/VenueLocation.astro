
---
import type { VenueProConfig } from '../../types/venuepro';

interface Props {
  location: VenueProConfig['location'];
  demo: boolean;
}

const { location, demo } = Astro.props;

const showAddress = !demo && Boolean(location.address.trim());

const showMapLink =
  showAddress && /^https:\/\/\S+$/i.test(location.mapsUrl.trim());
---

<section
  id="lokacija"
  class="scroll-mt-20 bg-[var(--vp-bg)] py-20 md:py-28"
>
  <div class="mx-auto max-w-[1440px] px-6 lg:px-12">

    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">

      <!-- INFORMATION -->
      <div>
        <p class="mb-7 text-[11px] font-bold tracking-[0.2em] text-[var(--vp-accent)]">
          {location.eyebrow}
        </p>

        <h2 class="font-display text-[clamp(3rem,5.2vw,5.6rem)] leading-[1.06] tracking-[-0.055em]">
          {location.title}
        </h2>

        <p class="mt-8 max-w-[480px] text-base leading-8 text-[var(--vp-muted)]">
          {location.description}
        </p>

        <div class="mt-12 border-t border-[#D8CDBF]">
          {location.details.map((detail) => (
            <div class="grid gap-3 border-b border-[#D8CDBF] py-6 sm:grid-cols-[150px_1fr] sm:gap-6">
              <span class="text-[10px] font-bold tracking-[0.14em] text-[var(--vp-accent)]">
                {detail.label}
              </span>

              <p class="text-sm leading-7 text-[var(--vp-muted)]">
                {detail.value}
              </p>
            </div>
          ))}
        </div>

        <div class="mt-9 flex flex-wrap gap-4">
          {showMapLink && (
            <a
              href={location.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-12 items-center gap-4 bg-[var(--vp-ink)] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[var(--vp-accent)]"
            >
              Pogledajte lokaciju
              <span aria-hidden="true">↗</span>
            </a>
          )}

          <a
            href="#upit"
            class="inline-flex min-h-12 items-center gap-4 border border-[var(--vp-ink)] px-6 py-3 text-sm font-semibold transition hover:bg-[var(--vp-ink)] hover:text-white"
          >
            Kontaktirajte nas ↗
          </a>
        </div>
      </div>

      <!-- EDITORIAL LOCATION PANEL -->
      <div class="flex min-w-0 flex-col">
        <div class="relative flex min-h-[420px] flex-1 flex-col justify-between overflow-hidden bg-[#E6DED2] p-7 sm:min-h-[520px] sm:p-12">

          <div class="relative z-10 flex flex-wrap items-start justify-between gap-5">
            <span class="text-[10px] font-bold tracking-[0.2em] text-[#716858]">
              MESTO DOGAĐAJA
            </span>

            <span class="border border-[#A98C64] px-4 py-2 text-[10px] font-bold tracking-[0.12em] text-[#716858]">
              {demo ? 'DEMO PRIKAZ' : 'LOKACIJA'}
            </span>
          </div>

          <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
            <div class="absolute -right-20 top-20 h-80 w-80 rounded-full border border-[#A98C64]/35 sm:h-[480px] sm:w-[480px]"></div>
            <div class="absolute -right-4 top-40 h-56 w-56 rounded-full border border-[#A98C64]/40 sm:h-80 sm:w-80"></div>
            <div class="absolute right-14 top-56 h-32 w-32 rounded-full border border-[#A98C64]/35 sm:h-44 sm:w-44"></div>
          </div>

          <div class="relative z-10">
            <p class="mb-5 text-xs font-bold tracking-[0.24em] text-[#716858]">
              SRBIJA
            </p>

            <p class="font-display text-[clamp(3.5rem,8vw,8rem)] leading-none tracking-[-0.065em] text-[#292824] [overflow-wrap:anywhere]">
              {location.city}
            </p>

            {showAddress ? (
              <p class="mt-7 max-w-md text-base leading-7 text-[#514C44]">
                {location.address}
              </p>
            ) : (
              <p class="mt-7 max-w-sm text-sm leading-7 text-[#716858]">
                {demo
                  ? 'Ilustrativna prezentacija grada. Tačna adresa nije navedena.'
                  : 'Za detalje o lokaciji pošaljite upit.'}
              </p>
            )}
          </div>
        </div>

        {demo && (
          <p class="mt-5 text-xs leading-7 text-[var(--vp-muted)]">
            {location.note}
          </p>
        )}
      </div>
    </div>
  </div>
</section>
