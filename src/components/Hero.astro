---
import type { SiteConfig } from '../types/site';
interface Props { site: SiteConfig }
const { site } = Astro.props;
const hero = site.hero;
---
<section id="vrh" class="overflow-hidden border-b border-line">
  <div class="container-shell grid min-h-[630px] items-center gap-12 py-15 lg:grid-cols-[1.05fr_.95fr] lg:gap-18 lg:py-24">
    <div class="relative z-10 max-w-2xl">
      <p class="section-kicker mb-7 flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-clay"></span>{hero.eyebrow}</p>
      <h1 class="font-display text-[clamp(3.8rem,7.2vw,7.4rem)] leading-[.96] tracking-[-.07em]">{hero.headline}<br /><em class="font-normal text-clay">{hero.emphasis}</em></h1>
      <p class="mt-8 max-w-lg text-[1rem] leading-[1.9] text-muted md:text-[1.08rem]">{hero.description}</p>
      <div class="mt-10 flex flex-wrap items-center gap-7">
        <a class="btn-primary" href={hero.primary.href}>{hero.primary.label}<span aria-hidden="true">↗</span></a>
        <a class="btn-secondary" href={hero.secondary.href}>{hero.secondary.label}<span aria-hidden="true">↗</span></a>
      </div>
      <div class="mt-14 flex items-center gap-3 border-t border-line pt-6 text-xs font-semibold text-muted"><span class="text-lg text-clay" aria-hidden="true">✳</span>{hero.note}</div>
    </div>
    <div class="relative mx-auto h-[470px] w-full max-w-[540px] md:h-[590px]" aria-label={hero.imageAlt ?? 'Dekorativni vizuelni primer'}>
      {hero.image ? <img src={hero.image} alt={hero.imageAlt ?? ''} class="h-full w-full rounded-t-[180px] rounded-b-3xl object-cover" fetchpriority="high" /> : <div class="relative h-full w-full overflow-hidden rounded-t-[180px] rounded-b-3xl bg-[#d9d7c8] soft-shadow" aria-hidden="true">
        <div class="absolute top-[9%] left-[15%] h-[58%] w-[70%] rounded-t-full bg-[#b3bbaa]"></div>
        <div class="absolute top-[18%] left-[26%] h-[52%] w-[50%] rounded-t-full bg-[#e7e0cd]"></div>
        <div class="absolute bottom-0 left-0 h-[32%] w-full bg-[#c3b39b]"></div>
        <div class="absolute bottom-[19%] left-[16%] h-[31%] w-[68%] rounded-[54%_46%_15%_15%] bg-[#a17c65] shadow-2xl"></div>
        <div class="absolute bottom-[17%] left-[27%] h-[20%] w-[47%] rounded-[55%_45%_9%_9%] bg-[#c8a78b]"></div>
        <div class="absolute right-[4%] bottom-[20%] h-[32%] w-[3%] rotate-[-17deg] bg-[#455d4c]"></div>
        <div class="absolute right-[0%] bottom-[45%] h-[22%] w-[28%] rounded-full bg-[#728b6a] blur-[3px]"></div>
      </div>}
      <div class="absolute -bottom-5 -left-3 rounded-2xl border border-white/70 bg-paper/95 p-5 shadow-xl backdrop-blur-sm md:-left-8 md:p-6">
        <span class="section-kicker !text-[.55rem]">ESTETIKA + FUNKCIJA</span>
        <p class="mt-2 font-display text-2xl tracking-tight">Detalji čine razliku.</p>
      </div>
      <div class="absolute right-0 -top-4 grid h-17 w-17 place-items-center rounded-full bg-clay text-3xl text-white md:-right-6 md:h-22 md:w-22" aria-hidden="true">✳</div>
    </div>
  </div>
</section>
