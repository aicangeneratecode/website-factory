---
import type { SiteConfig } from '../types/site';
interface Props { site: SiteConfig }
const { site } = Astro.props;
const section = site.reviews;
---
<section id="utisci" class="section-space">
  <div class="container-shell">
    <div class="mb-12 flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="section-kicker mb-5">{section.eyebrow}</p><h2 class="section-title max-w-2xl">{section.title}</h2></div><span class="text-xs font-bold tracking-widest text-muted">REČI KOJE ZNAČE</span></div>
    <div class="grid gap-5 md:grid-cols-3">
      {section.items.map((item) => <figure class="flex min-h-76 flex-col justify-between rounded-[1.65rem] border border-line bg-paper p-8">
        <div><div aria-hidden="true" class="font-display text-6xl leading-none text-clay">“</div><blockquote class="mt-3 font-display text-[1.4rem] leading-[1.45] tracking-tight">{item.quote}</blockquote></div>
        <figcaption class="mt-8 border-t border-line pt-5"><p class="text-sm font-extrabold">{item.author}</p><p class="mt-1 text-xs text-muted">{item.detail}</p>{item.example && <span class="mt-3 inline-block rounded-full bg-canvas px-3 py-1 text-[.6rem] font-bold uppercase tracking-wider text-muted">Demo sadržaj</span>}</figcaption>
      </figure>)}
    </div>
  </div>
</section>
