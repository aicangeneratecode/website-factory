---
import type { SiteConfig } from '../types/site';
interface Props { site: SiteConfig }
const { site } = Astro.props;
const info = site.contact;
---
<section id="kontakt" class="overflow-hidden bg-ink text-white">
  <div class="container-shell grid gap-14 py-21 md:grid-cols-[1.2fr_.8fr] md:gap-20 md:py-28">
    <div><p class="section-kicker mb-7 !text-[#dba58d]">{info.eyebrow}</p><h2 class="font-display max-w-2xl text-[clamp(3rem,6vw,6rem)] leading-[1.03] tracking-[-.055em]">{info.title}</h2><p class="mt-7 max-w-xl text-base leading-[1.9] text-white/65">{info.description}</p><span class="mt-10 block font-display text-7xl text-[#dba58d]" aria-hidden="true">↗</span></div>
    <div class="self-center rounded-[1.7rem] border border-white/20 bg-white/5 p-8 md:p-10"><p class="mb-8 text-[.65rem] font-bold tracking-[.2em] text-white/55">KONTAKT INFORMACIJE</p>
      <div class="space-y-8">
        <div><p class="mb-2 text-[.6rem] font-extrabold tracking-widest text-white/50">TELEFON</p>{site.demoMode ? <span class="font-display text-2xl">{info.phone}</span> : <a href={'tel:' + info.phoneHref} class="font-display text-2xl hover:text-[#dba58d]">{info.phone}</a>}</div>
        <div><p class="mb-2 text-[.6rem] font-extrabold tracking-widest text-white/50">EMAIL</p>{site.demoMode ? <span class="break-all font-display text-xl">{info.email}</span> : <a href={'mailto:' + info.email} class="break-all font-display text-xl hover:text-[#dba58d]">{info.email}</a>}</div>
        <div><p class="mb-2 text-[.6rem] font-extrabold tracking-widest text-white/50">LOKACIJA & VREME</p><p class="text-sm leading-7">{info.city}<br /><span class="text-white/60">{info.hours}</span></p></div>
      </div>
      {site.demoMode && <p class="mt-8 rounded-lg border border-white/20 p-3 text-xs leading-5 text-white/60">Demo kontakt podaci — zameniti pre objave.</p>}
      {info.instagram && !site.demoMode && <a class="mt-8 inline-flex items-center gap-2 text-sm underline" href={info.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}
    </div>
  </div>
</section>
