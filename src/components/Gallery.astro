---
import type { SiteConfig } from '../types/site';
interface Props { site: SiteConfig }
const { site } = Astro.props;
const section = site.gallery;
---
<section id="projekti" class="section-space bg-[#ebeae3]">
  <div class="container-shell">
    <div class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div><p class="section-kicker mb-5">{section.eyebrow}</p><h2 class="section-title max-w-xl">{section.title}</h2></div>
      <p class="max-w-sm text-sm leading-[1.9] text-muted">{section.lead}</p>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {section.items.map((item) => <figure class="relative aspect-[1.2/1] overflow-hidden rounded-[1.7rem] bg-white md:aspect-[1.1/1]">
        {item.image ? <img src={item.image} alt={item.alt ?? item.title} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-500 hover:scale-105" /> : <div class:list={['gallery-art', 'gallery-' + item.tone]} aria-hidden="true"></div>}
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/55 to-transparent"></div>
        <figcaption class="absolute inset-x-0 bottom-0 p-7 text-white md:p-9"><p class="mb-3 text-[.6rem] font-extrabold tracking-[.23em] text-white/85">{item.category}</p><h3 class="font-display text-3xl md:text-4xl">{item.title}</h3>{!item.image && <span class="mt-3 inline-block text-[.7rem] text-white/75">{item.description}</span>}</figcaption>
      </figure>)}
    </div>
  </div>
</section>
