---
import '../styles/global.css';

import type { ClinicProConfig } from '../types/clinicpro';
import ClinicHero from '../components/clinicpro/ClinicHero.astro';
import ClinicFirstVisit from '../components/clinicpro/ClinicFirstVisit.astro';
import ClinicServices from '../components/clinicpro/ClinicServices.astro';
import ClinicTeam from '../components/clinicpro/ClinicTeam.astro';
import ClinicEquipment from '../components/clinicpro/ClinicEquipment.astro';
import ClinicPrices from '../components/clinicpro/ClinicPrices.astro';
import ClinicFaq from '../components/clinicpro/ClinicFaq.astro';
import ClinicBooking from '../components/clinicpro/ClinicBooking.astro';

interface Props {
  config: ClinicProConfig;
}

const { config } = Astro.props;
const team = config.team ?? [];
const equipment = config.equipment ?? [];
const prices = config.prices ?? [];
const bookingUrl = config.bookingUrl.trim();
const hasServices = config.services.length > 0;
const hasFaq = config.faq.length > 0;
const visibleSections = new Set([
  '#prva-poseta', '#termin', '#sadrzaj',
  ...(hasServices ? ['#usluge'] : []),
  ...(team.length ? ['#tim'] : []),
  ...(equipment.length ? ['#oprema'] : []),
  ...(prices.length ? ['#cene'] : []),
  ...(hasFaq ? ['#pitanja'] : []),
]);
const faq = config.faq.map((item) => ({
  ...item,
  link: item.link?.href.startsWith('#') && !visibleSections.has(item.link.href)
    ? undefined
    : item.link,
}));
---
<!doctype html>
<html lang="sr-Latn-RS">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={config.description} />
    {config.demo && <meta name="robots" content="noindex,nofollow" />}
    <title>{config.brand} | Fizioterapija i rehabilitacija</title>
  </head>
  <body class="clinic bg-[#f5f7f1] text-[#172e28]">
    <a href="#sadrzaj" class="sr-only focus:not-sr-only focus:absolute focus:z-10 focus:bg-white focus:p-4">Preskoči na sadržaj</a>
    <header class="mx-auto max-w-7xl px-4 pt-4 sm:px-6 lg:px-12">
      <div class="clinic-panel flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border border-[#cdd9ce] bg-[#fcfdf9] px-4 py-3 sm:px-6">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <a href="#sadrzaj" class="text-xl font-bold tracking-tight">{config.brand}</a>
          {config.demo && <span class="text-xs text-[#405a50]">Demo Concept</span>}
        </div>
        <nav aria-label="Glavna navigacija" class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-semibold">
          {hasServices && <a href="#usluge">Usluge</a>}
          {prices.length > 0 && <a href="#cene">Cenovnik</a>}
          {hasFaq && <a href="#pitanja">Pitanja</a>}
          <a href="#termin" class="clinic-action inline-flex items-center bg-[#204a3d] px-4 py-2 text-white transition-colors hover:bg-[#172e28]">{config.heroCopy?.bookingLabel ?? 'Zakažite termin'}</a>
        </nav>
      </div>
    </header>
    <main id="sadrzaj">
      <ClinicHero config={config} />
      <ClinicFirstVisit firstVisit={config.firstVisit} />

      {hasServices && <ClinicServices demo={config.demo} services={config.services} hasPrices={prices.length > 0} />}

      {team.length > 0 && (
        <ClinicTeam team={team} demo={config.demo} />
      )}

      {equipment.length > 0 && (
        <ClinicEquipment
          equipment={equipment}
          image={config.equipmentImage}
          intro={config.equipmentIntro}
          demo={config.demo}
        />
      )}

      {prices.length > 0 && (
        <ClinicPrices prices={prices} demo={config.demo} />
      )}

      {hasFaq && <ClinicFaq faq={faq} />}

      <ClinicBooking bookingUrl={bookingUrl} copy={config.bookingCopy} demo={config.demo} prices={prices} />
    </main>
    <footer class="mx-auto flex max-w-7xl flex-wrap justify-between gap-4 px-6 py-6 text-sm lg:px-12">
      <span>{config.brand}{config.demo && ' · Demo Concept'}</span>
      {config.demo && <a href="/" class="underline underline-offset-4">Svi šabloni</a>}
    </footer>
  </body>
</html>

<style>
  .clinic :global(.clinic-display) {
    font-family: var(--font-sans);
    font-weight: 650;
    text-wrap: balance;
  }

  .clinic :global(.clinic-hero),
  .clinic :global(.clinic-panel) {
    border-radius: 1.25rem;
  }

  .clinic :global(.clinic-action),
  .clinic :global(.clinic-field) {
    border-radius: 0.625rem;
    min-height: 44px;
  }

  .clinic :global(.clinic-action) {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .clinic :global(.clinic-hero-photo) {
    aspect-ratio: 3 / 2;
    background: #204a3d;
  }

  .clinic :global(a:focus-visible),
  .clinic :global(button:focus-visible),
  .clinic :global(summary:focus-visible),
  .clinic :global(input:focus-visible),
  .clinic :global(select:focus-visible) {
    outline: 2px solid #bd704e;
    outline-offset: 3px;
  }

  .clinic :global(a) {
    text-underline-offset: 0.25em;
  }

  .clinic nav a:hover {
    text-decoration: underline;
  }
</style>
