
---
import '../styles/global.css';
import FactoryBackLink from '../components/FactoryBackLink.astro';
import type { ProjectProConfig } from '../types/projectpro';
import ProjectHero from '../components/projectpro/ProjectHero.astro';
import ProjectFaq from '../components/projectpro/ProjectFaq.astro';
import ProjectGallery from '../components/projectpro/ProjectGallery.astro';
import BeforeAfter from '../components/projectpro/BeforeAfter.astro';
import ProjectServices from '../components/projectpro/ProjectServices.astro';
import ProcessTimeline from '../components/projectpro/ProcessTimeline.astro';
import ProjectTestimonials from '../components/projectpro/ProjectTestimonials.astro';
import EstimateForm from '../components/projectpro/EstimateForm.astro';


interface Props {
  config: ProjectProConfig;
}

const { config } = Astro.props;
const { brand, hero, theme, navigation } = config;

const themeStyle = [
  `--pp-bg:${theme.background}`,
  `--pp-surface:${theme.surface}`,
  `--pp-ink:${theme.ink}`,
  `--pp-muted:${theme.muted}`,
  `--pp-accent:${theme.accent}`
].join(';');

const siteBase = Astro.site ?? Astro.url;

const canonicalUrl = new URL(
  Astro.url.pathname,
  siteBase
).href;

const socialImageUrl = new URL(
  hero.image,
  siteBase
).href;

const allowIndexing =
  !config.demo &&
  siteBase.hostname !== 'example.com';

---

<!doctype html>
<html lang="sr-Latn-RS">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={theme.background} />

    <title>{config.seo.title}</title>

    <meta
      name="description"
      content={config.seo.description}
    />

    <meta
      name="robots"
      content={allowIndexing ? 'index,follow' : 'noindex,nofollow'}
    />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sr_RS" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={config.seo.title} />
    <meta
      property="og:description"
      content={config.seo.description}
    />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={config.seo.title} />
    <meta
      name="twitter:description"
      content={config.seo.description}
    />
    <meta name="twitter:image" content={socialImageUrl} />

  </head>

  <body style={themeStyle} class="pp-body">
    <a href="#sadrzaj" class="sr-only focus:not-sr-only">
      Preskoči na sadržaj
    </a>

    {config.demo && <FactoryBackLink />}

    <!-- HEADER -->
    <header class="pp-header" style={config.demo ? "--pp-header-top:var(--factory-bar-height)" : undefined}>
      <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-6 px-6 py-5 lg:px-12">
        <a href="#pocetna" class="flex items-center gap-3">
          <span class="grid h-11 w-11 place-items-center bg-[var(--pp-ink)] text-xl font-bold text-white">
            {brand.name.trim().charAt(0)}.
          </span>
          <span>
            <strong class="block text-lg font-extrabold tracking-[-0.05em]">
              {brand.name}
            </strong>
            <small class="block text-[9px] font-bold tracking-[0.22em] text-[var(--pp-muted)]">
              {brand.descriptor}
            </small>
          </span>
        </a>

        <nav aria-label="Glavna navigacija" class="hidden items-center gap-9 lg:flex">
          {navigation.map((item) => (
            <a
              href={item.href}
              class="text-[13px] font-semibold text-[var(--pp-ink)] transition hover:opacity-55"
            >
              {item.label}
            </a>
          ))}
        </nav>

        <a href="#upit" class="pp-action pp-header-cta hidden lg:inline-flex">
          {hero.primary.label} <span aria-hidden="true">↗</span>
        </a>

        <details class="pp-mobile-menu relative lg:hidden">
          <summary class="pp-action cursor-pointer rounded border border-black/20 px-4 py-2 text-sm font-semibold">
            Meni
          </summary>

          <nav aria-label="Mobilna navigacija" class="absolute right-0 top-12 z-30 flex w-52 flex-col gap-4 border border-black/10 bg-white p-5 shadow-lg">
            {navigation.map((item) => (
              <a href={item.href} class="text-sm font-semibold">
                {item.label}
              </a>
            ))}
          </nav>
        </details>
      </div>
    </header>

    <main id="sadrzaj">
      <ProjectHero hero={hero} demo={config.demo} />

      <ProjectServices services={config.services} actionLabel={hero.primary.label} />

      <ProjectGallery portfolio={config.portfolio} demo={config.demo} />

      {config.beforeAfter?.verifiedPair && <BeforeAfter comparison={config.beforeAfter} />}

      <ProcessTimeline process={config.process} demo={config.demo} />

      {config.testimonials?.items.some((item) => item.verified) && (
        <ProjectTestimonials testimonials={config.testimonials} demo={config.demo} />
      )}

      {config.faq && config.faq.items.length > 0 && <ProjectFaq faq={config.faq} />}

      <EstimateForm estimate={config.estimate} demo={config.demo} />
    </main>

    <footer class="bg-[var(--pp-ink)] px-6 py-8 text-white lg:px-12">
      <div class="mx-auto flex max-w-[1344px] flex-wrap justify-between gap-4 text-xs">
        <span>{brand.name}{config.demo && ' — Demo Concept'}</span>
        {config.demo && <span>Prikaz dizajna · Nije stvarna kompanija</span>}
      </div>
    </footer>
  </body>
</html>

<style>
  .pp-body {
    margin: 0;
    background: var(--pp-bg);
    color: var(--pp-ink);
  }

  .pp-header {
    position: sticky;
    top: var(--pp-header-top, 0);
    z-index: 40;
    border-bottom: 1px solid rgba(0, 0, 0, 0.10);
    background: var(--pp-bg);
  }

  .pp-body :global(.pp-action),
  .pp-body :global(.pp-field) {
    border-radius: 0.625rem;
  }

  .pp-body :global(.pp-action) {
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .pp-body :global(.pp-heading) {
    font-family: var(--font-sans);
    font-weight: 700;
    text-wrap: balance;
  }

  .pp-header-cta {
    align-items: center;
    gap: 18px;
    border: 1px solid var(--pp-ink);
    padding: 12px 19px;
    font-size: 12px;
    font-weight: 750;
    transition: background 0.2s, color 0.2s;
  }

  .pp-header-cta:hover {
    background: var(--pp-ink);
    color: white;
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-header-cta {
      transition: none;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>('.pp-mobile-menu')
    .forEach((menu) => {
      menu.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
        link.addEventListener('click', () => {
          menu.open = false;
        });
      });

      menu.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    });
</script>
