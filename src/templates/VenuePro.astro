
---
import '../styles/global.css';
import type { VenueProConfig } from '../types/venuepro';
import VenueGallery from '../components/venuepro/VenueGallery.astro';
import VenueEvents from '../components/venuepro/VenueEvents.astro';


interface Props {
  config: VenueProConfig;
}

const { config } = Astro.props;
const { brand, hero, theme, navigation, intro } = config;

const themeStyle = [
  `--vp-bg:${theme.background}`,
  `--vp-surface:${theme.surface}`,
  `--vp-ink:${theme.ink}`,
  `--vp-muted:${theme.muted}`,
  `--vp-accent:${theme.accent}`
].join(';');

const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base).href;
const socialImage = new URL(hero.image, base).href;

const shouldIndex =
  !config.demo && base.hostname !== 'example.com';
---

<!doctype html>
<html lang="sr-Latn-RS">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={theme.background} />

    <title>{config.seo.title}</title>
    <meta
      name="description"
      content={config.seo.description}
    />
    <meta
      name="robots"
      content={shouldIndex ? 'index,follow' : 'noindex,nofollow'}
    />

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sr_RS" />
    <meta property="og:title" content={config.seo.title} />
    <meta
      property="og:description"
      content={config.seo.description}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
  </head>

  <body class="vp-body" style={themeStyle}>
    <a
      href="#sadrzaj"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-4"
    >
      Preskoči na sadržaj
    </a>

    <main id="sadrzaj">

      <!-- FULL SCREEN HERO -->
      <section
        id="pocetna"
        class="relative isolate flex min-h-[740px] flex-col overflow-hidden bg-[#292824] text-white lg:min-h-[860px]"
      >
        <!-- Background image -->
        <img
          src={hero.image}
          alt={hero.imageAlt}
          width="1920"
          height="1280"
          fetchpriority="high"
          class="absolute inset-0 -z-20 h-full w-full object-cover"
        />

        <!-- Gradient overlay -->
        <div
          class="absolute inset-0 -z-10 bg-gradient-to-r from-[#171714]/85 via-[#171714]/50 to-[#171714]/25"
        ></div>

        <!-- HEADER -->
        <header class="relative z-20">
          <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-6 px-6 py-7 lg:px-12">

            <a
              href="#pocetna"
              class="flex items-center gap-3"
              aria-label={`${brand.name} — početna`}
            >
              <span class="font-display text-4xl italic leading-none">
                {brand.monogram}
              </span>

              <span>
                <strong class="block text-base font-semibold tracking-[0.25em]">
                  {brand.name}
                </strong>
                <small class="mt-1 block text-[9px] font-medium tracking-[0.15em] text-white/65">
                  {brand.descriptor}
                </small>
              </span>
            </a>

            <nav
              aria-label="Glavna navigacija"
              class="hidden items-center gap-9 lg:flex"
            >
              {navigation.map((item) => (
                <a
                  href={item.href}
                  class="text-[12px] font-medium tracking-wide text-white/85 transition hover:text-white"
                >
                  {item.label}
                </a>
              ))}
            </nav>

            <a
              href="#upit"
              class="hidden border border-white/60 px-6 py-3 text-xs font-semibold tracking-wide transition hover:bg-white hover:text-[#292824] lg:inline-flex"
            >
              Rezervacije i upiti ↗
            </a>

            <details class="vp-mobile-menu relative lg:hidden">
              <summary class="cursor-pointer border border-white/50 px-4 py-2 text-xs font-semibold">
                Meni
              </summary>

              <nav
                aria-label="Mobilna navigacija"
                class="absolute right-0 top-12 z-30 flex w-60 flex-col gap-4 border border-[#DDD4C8] bg-[#F7F4EF] p-6 text-[#292824] shadow-xl"
              >
                {navigation.map((item) => (
                  <a href={item.href} class="text-sm font-semibold">
                    {item.label}
                  </a>
                ))}

                <a
                  href="#upit"
                  class="border-t border-black/15 pt-4 text-sm font-semibold"
                >
                  Pošaljite upit ↗
                </a>
              </nav>
            </details>
          </div>
        </header>

        <!-- HERO CONTENT -->
        <div class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-1 flex-col justify-end px-6 pb-24 pt-24 lg:px-12 lg:pb-28">

          {config.demo && (
            <a
              href="/"
              class="mb-12 inline-flex items-center gap-3 self-start text-xs font-medium text-white/80 hover:text-white"
            >
              ← Svi šabloni
            </a>
          )}

          <div class="max-w-[960px]">
            <p class="mb-7 text-[10px] font-bold tracking-[0.24em] text-[#E9D6B6] md:text-xs">
              {hero.eyebrow}
            </p>

            <h1 class="font-display text-[clamp(3.1rem,7.2vw,7.4rem)] leading-[1.06] tracking-[-0.055em] [overflow-wrap:anywhere]">
              {hero.headline}

              <span class="mt-2 block italic font-normal text-[#E9D6B6]">
                {hero.highlight}
              </span>
            </h1>

            <p class="mt-9 max-w-[520px] text-sm leading-8 text-white/85 md:text-base">
              {hero.description}
            </p>

            <div class="mt-10 flex flex-wrap items-center gap-7">
              <a
                href={hero.primary.href}
                class="inline-flex min-h-14 items-center gap-6 bg-[#E9D6B6] px-7 py-4 text-sm font-semibold text-[#292824] transition hover:bg-white"
              >
                {hero.primary.label}
                <span aria-hidden="true">↗</span>
              </a>

              <a
                href={hero.secondary.href}
                class="border-b border-white/70 pb-2 text-sm font-semibold text-white transition hover:border-white"
              >
                {hero.secondary.label} ↗
              </a>
            </div>
          </div>

          <div class="mt-16 flex flex-wrap justify-between gap-4 border-t border-white/25 pt-6">
            <span class="text-[10px] font-semibold tracking-[0.2em] text-white/70">
              {brand.city} · DEMO CONCEPT
            </span>

            <span class="text-[10px] font-semibold tracking-[0.2em] text-white/70">
              ILUSTRATIVNA FOTOGRAFIJA
            </span>
          </div>
        </div>
      </section>

      <!-- EDITORIAL INTRO -->
      <section class="bg-[var(--vp-bg)] px-6 py-20 lg:px-12 lg:py-28">
        <div class="mx-auto grid max-w-[1344px] gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
          <div>
            <p class="text-[11px] font-bold tracking-[0.23em] text-[var(--vp-accent)]">
              {intro.eyebrow}
            </p>

            <div class="mt-8 h-px w-28 bg-[var(--vp-accent)]"></div>
          </div>

          <div>
            <h2 class="max-w-[840px] font-display text-[clamp(3rem,5vw,5.7rem)] leading-[1.1] tracking-[-0.05em]">
              {intro.title}
            </h2>

            <p class="mt-8 max-w-[590px] text-base leading-9 text-[var(--vp-muted)]">
              {intro.description}
            </p>
          </div>
        </div>
      </section>

      <!-- VENUE GALLERY -->
      <VenueGallery
        gallery={config.gallery}
        demo={config.demo}
        />
            
    <!-- EVENT TYPES -->
    <VenueEvents
    events={config.events}
    demo={config.demo}
    />


      <!-- TEMPORARY SECTION STRUCTURE -->
      <section class="bg-white px-6 py-20 lg:px-12 lg:py-28">
        <div class="mx-auto max-w-[1344px]">
          <p class="text-xs font-bold tracking-[0.2em] text-[var(--vp-accent)]">
            STRUKTURA DEMO SAJTA
          </p>

          <div class="mt-12 grid gap-5 md:grid-cols-2">
           
        {config.sections
            .filter(
            (section) =>
                !['galerija', 'dogadjaji'].includes(section.id)
            )
            .map((section) => (
              <section
                id={section.id}
                class="scroll-mt-24 border border-[#E7E0D6] bg-[var(--vp-bg)] p-8 md:p-10"
              >
                <span class="font-display text-3xl italic text-[var(--vp-accent)]">
                  {section.number}
                </span>

                <h3 class="mt-7 font-display text-3xl tracking-tight">
                  {section.title}
                </h3>

                <p class="mt-4 text-sm leading-7 text-[var(--vp-muted)]">
                  {section.description}
                </p>

                <span class="mt-9 inline-block border-t border-[#D2C7B8] pt-4 text-[10px] font-bold tracking-widest text-[var(--vp-accent)]">
                  SADRŽAJ U PRIPREMI
                </span>
              </section>
            ))}
          </div>
        </div>
      </section>

    </main>

    <!-- FOOTER -->
    <footer class="bg-[var(--vp-ink)] px-6 py-9 text-white lg:px-12">
      <div class="mx-auto flex max-w-[1344px] flex-wrap justify-between gap-4 text-xs">
        <span>{brand.name} — Demo Concept</span>
        <span>Prikaz dizajna · Nije stvarna kompanija</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .vp-body {
    margin: 0;
    background: var(--vp-bg);
    color: var(--vp-ink);
  }
</style>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>('.vp-mobile-menu')
    .forEach((menu) => {
      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          menu.open = false;
        });
      });

      menu.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          menu.open = false;
        }
      });
    });
</script>
