---
import '../styles/global.css';
import type { SiteConfig } from '../types/site';

interface Props { site: SiteConfig }
const { site } = Astro.props;
const base = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, base).href;
const imageUrl = new URL(site.seo.image, base).href;
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.brand.name,
  description: site.seo.description,
  url: canonical,
  areaServed: { '@type': 'City', name: site.contact.city.split(',')[0] },
  ...(site.demoMode ? {} : { telephone: site.contact.phoneHref, email: site.contact.email }),
};
const shouldIndex = !site.demoMode && site.seo.robots === 'index,follow' && base.hostname !== 'example.com';
---
<!doctype html>
<html lang="sr-Latn-RS">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6f2" />
    <title>{site.seo.title}</title>
    <meta name="description" content={site.seo.description} />
    <meta name="robots" content={shouldIndex ? 'index,follow' : 'noindex,nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.seo.locale} />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:title" content={site.seo.title} />
    <meta property="og:description" content={site.seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.seo.title} />
    <meta name="twitter:description" content={site.seo.description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema).replace(/</g, '\u003c')}></script>
  </head>
  <body class="antialiased">
    <a href="#sadrzaj" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-4">Preskoči na sadržaj</a>
    <slot />
  </body>
</html>
