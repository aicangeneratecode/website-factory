---
import '../styles/global.css';

const base = Astro.site ?? new URL('https://example.com');
const canonical = new URL('/', base).href;
const indexable = process.env.SHOWCASE_INDEXABLE === 'true' && base.hostname !== 'example.com';
const title = 'Website Factory | Sajtovi za poslovanje u Srbiji';
const description = 'Tri demo sajta za renoviranje, proslave i fizioterapiju. Istražite usluge, galerije i tok upita na svakom sajtu.';

const templates = [
  {
    name: 'ProjectPro',
    category: 'Renoviranje i adaptacije',
    description: 'Od inspiracije i poređenja enterijera do upita za procenu radova.',
    image: '/images/projectpro/hero.jpg',
    href: '/projectpro/',
  },
  {
    name: 'VenuePro',
    category: 'Proslave i događaji',
    description: 'Galerija prostora, rasporedi sedenja i upit za željeni datum.',
    image: '/images/venuepro/hero.jpg',
    href: '/venuepro/',
  },
  {
    name: 'ClinicPro',
    category: 'Fizioterapija i rehabilitacija',
    description: 'Prvi pregled, predstavljanje tima, cenovnik i demo zakazivanje.',
    image: '/images/clinicpro/hero-session.jpg',
    href: '/clinicpro/',
  },
];
---
<!doctype html>
<html lang="sr-Latn-RS">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,nofollow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sr_RS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(templates[0].image, base).href} />
  </head>
  <body class="bg-[#f5f2e9] text-[#202b24]">
    <a href="#sadrzaj" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-4">Preskoči na sadržaj</a>
    <header class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-8 lg:px-12">
      <a href="/" class="flex min-h-11 items-center gap-3 font-bold">
        <span aria-hidden="true" class="grid size-9 place-items-center rounded-[10px] bg-[#202b24] text-sm text-[#f5f2e9]">WF</span>
        Website Factory
      </a>
      <nav aria-label="Glavna navigacija">
        <a href="#sabloni" class="inline-flex min-h-11 items-center text-sm font-bold underline decoration-[#9b5a42] underline-offset-4">Šabloni</a>
      </nav>
    </header>
    <main id="sadrzaj" class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
      <section class="grid overflow-hidden rounded-[20px] bg-[#202b24] text-[#f5f2e9] lg:grid-cols-[1fr_0.9fr]">
        <div class="self-center p-7 sm:p-12 lg:p-14">
          <h1 class="font-display text-[clamp(2.75rem,6vw,5.5rem)] leading-[0.97] tracking-[-0.055em]">Sajtovi za <em class="font-normal text-[#e5be9a]">vaš posao.</em></h1>
          <p class="mt-6 max-w-md leading-7 text-[#e6e3d8]">Izaberite demo za svoju delatnost i isprobajte kako posetioci pregledaju ponudu i šalju upit.</p>
          <a href="#sabloni" class="mt-7 inline-flex min-h-11 items-center gap-4 rounded-[10px] bg-[#e5be9a] px-5 py-3 text-sm font-bold text-[#202b24] transition-colors hover:bg-[#f5f2e9]">Pogledajte šablone <span aria-hidden="true">↓</span></a>
        </div>
        <div class="relative aspect-[2/1] overflow-hidden bg-[#334238] lg:aspect-auto">
          <img src={templates[0].image} alt="" width="1200" height="800" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-center" />
        </div>
      </section>
      <section id="sabloni" aria-labelledby="sabloni-naslov" class="py-12 sm:py-18">
        <h2 id="sabloni-naslov" class="font-display text-4xl tracking-tight sm:text-5xl">Izaberite svoj demo</h2>
        <ul class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {templates.map((template) => (
            <li class="min-w-0">
              <a href={template.href} class="group flex h-full flex-col overflow-hidden rounded-[20px] border border-[#d7d5c9] bg-[#fffcf6] transition-colors hover:border-[#9b5a42]">
                <div class="aspect-[4/3] overflow-hidden bg-[#d7d5c9]">
                  <img src={template.image} alt="" width="1200" height="900" loading="lazy" decoding="async" class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-105" />
                </div>
                <div class="flex flex-1 flex-col p-5 sm:p-6">
                  <p class="text-sm font-semibold text-[#834a35]">{template.category}</p>
                  <h3 class="mt-2 font-display text-3xl tracking-tight">{template.name}</h3>
                  <p class="mt-3 leading-6 text-[#47554b]">{template.description}</p>
                  <div class="mt-auto pt-6">
                    <span class="flex min-h-11 items-center justify-between gap-3 border-t border-[#d7d5c9] pt-2 text-sm font-bold">
                      Pogledajte demo <span aria-hidden="true" class="grid size-8 place-items-center rounded-[10px] bg-[#e9e6da] transition-colors group-hover:bg-[#e5be9a]">↗</span>
                    </span>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>
    <footer class="border-t border-[#d7d5c9]">
      <div class="mx-auto flex max-w-7xl flex-wrap justify-between gap-3 px-5 py-6 text-sm sm:px-8 lg:px-12">
        <span class="font-bold">Website Factory</span>
        <p class="text-[#47554b]">Demo sajtovi sa ilustrativnim sadržajem.</p>
      </div>
    </footer>
  </body>
</html>
