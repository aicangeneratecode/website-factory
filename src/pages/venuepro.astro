
---
import config from '../../sites/venue-demo/site.json';
import VenuePro from '../templates/VenuePro.astro';
import type { VenueProConfig } from '../types/venuepro';

const layouts = config.capacity.layouts.map<VenueProConfig['capacity']['layouts'][number]>((layout) => {
  const { id } = layout;
  if (id !== 'banquet' && id !== 'cocktail' && id !== 'conference') {
    throw new Error(`Unsupported VenuePro room layout: ${id}`);
  }

  return { ...layout, id };
});

const venueConfig: VenueProConfig = {
  ...config,
  capacity: { ...config.capacity, layouts },
};
---

<VenuePro config={venueConfig} />
